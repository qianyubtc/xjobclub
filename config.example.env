# ========= 推了么（xjobclub）配置示例 =========
# 复制为 config.env 后填写；同名环境变量优先于本文件。config.env 已被 .gitignore 排除。

LISTEN=127.0.0.1:8125
BASE_URL=http://127.0.0.1:8125
DB_PATH=./xjobclub.db
UPLOAD_DIR=./uploads
SITE_TITLE=推了么

# ---- BinancePayTool 网关（建议独立实例，不与其它站共用）----
# 没有网关时：没有自动到账、没有认证付款，全部走手动确认
BPG_URL=http://127.0.0.1:8126
BPG_KEY=
CURRENCY=USDT
ORDER_TTL=1800

# ---- 管理员：X 用户名列表（逗号分隔，不带 @），用自己的账号登录即有后台权限 ----
ADMIN_HANDLES=
# 可选：后台只允许这些 IP / 网段访问
ADMIN_IP_ALLOW=

# ---- 反向代理 ----
TRUST_PROXY=false
TRUST_PROXY_HEADER=X-Forwarded-For

# ---- 推文抓取接口（测试时指向 mock）----
X_TWEET_API=https://cdn.syndication.twimg.com

# ---- 任务参数 ----
MIN_REWARD=0.1
MAX_REWARD=500
MAX_SLOTS=100
CLAIM_TTL_MIN=120
CLAIM_TTL_MIN_MIN=30
CLAIM_TTL_MAX_MIN=1440
RETENTION_OPTIONS=0,24,72,168
RETENTION_DEFAULT_H=24
PAY_WINDOW_OPTIONS=24,48,72
PAY_WINDOW_DEFAULT_H=48
DEADLINE_DEFAULT_DAYS=7
DEADLINE_MAX_DAYS=30
MAX_VARIANTS=5
VERIFY_ATTEMPTS=3

# ---- 履约与纠纷 ----
GRACE_REPORT_H=24
EVIDENCE_WINDOW_H=72
RECHECK_UNKNOWN_H=12
VOID_STRIKES=3
VOID_SUSPEND_DAYS=7
CONFIRM_REMIND_H=24,72

# ---- 信用额度（U）----
EXPOSURE_NEWBIE=20
EXPOSURE_REGULAR=200
EXPOSURE_SENIOR=2000
OPEN_TASKS_NEWBIE=1
OPEN_TASKS_REGULAR=3
OPEN_TASKS_SENIOR=10
CONCUR_NEWBIE=2
CONCUR_REGULAR=5
CONCUR_SENIOR=10
DAILY_NEWBIE=5
DAILY_REGULAR=20
DAILY_SENIOR=50

# ---- 发布方认证付款（需要网关）----
CERT_FEE_ENABLED=true
CERT_FEE_AMOUNT=0.1

# ---- 小法庭 ----
JURY_ENABLED=true
JURY_MIN_POOL=50
JURY_PANEL=7
JURY_INVITE=21
JURY_TYPES=B,D
JURY_WINDOW_H=48
JURY_APPEAL_H=24
